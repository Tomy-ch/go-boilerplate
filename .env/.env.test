# OS
OS_TZ=Asia/Tokyo

# Server
SERVER_APP_MODE=development # development or production
SERVER_ENV=local
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_SHUTDOWN_TIMEOUT=30s

# Database
DB_DRIVER=pgx
DB_HOST=postgres-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres-password
DB_NAME=test
DB_SSL_MODE=disable

# Database Connection
DB_CONN_MAX_OPEN=10
DB_CONN_MAX_IDLE=5
DB_CONN_MAX_LIFETIME=3m
DB_CONN_MAX_IDLE_TIME=1m

# Security
SECURITY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
SECURITY_CIDR="127.0.0.0/8"
