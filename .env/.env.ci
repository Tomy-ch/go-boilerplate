# OS
OS_TZ=Asia/Tokyo

# Application
APP_MODE=development # development or production
APP_NAME=Boilerplate
APP_ENV=ci
APP_SHUTDOWN_TIMEOUT=45s

# Server
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s

# Metrics
METRICS_HOST=0.0.0.0
METRICS_PORT=6060

# Observability
OBSERVABILITY_ENABLED=true
OBSERVABILITY_TARGET_STATUS_CODES=400,401,403,404,409,422,429,500,501,503

# Database
DB_DRIVER=pgx
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres-password
DB_NAME=test
DB_SSL_MODE=disable
DB_SLOW_QUERY_WARN_THRESHOLD=500ms

# Database Connection
DBCONN_MAX_OPEN=10
DBCONN_MAX_IDLE=5
DBCONN_MAX_LIFETIME=30m
DBCONN_MAX_IDLE_TIME=10m

# Security
SECURITY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
SECURITY_CIDR="127.0.0.0/8"
SECURITY_CONTENT_TYPE_NOSNIFF=nosniff
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_HSTS_MAX_AGE=0
SECURITY_HSTS_EXCLUDE_SUBDOMAINS=false
SECURITY_HSTS_PRELOAD_ENABLED=false
SECURITY_REFERRER_POLICY=no-referrer

# IP Rate Limiter
IP_RATE_LIMITER_ENABLED=true
IP_RATE_LIMITER_REQUESTS=60
IP_RATE_LIMITER_PER=1m
IP_RATE_LIMITER_BURST=10
IP_RATE_LIMITER_TTL=10m
IP_RATE_LIMITER_CLEANUP_INTERVAL=1m
