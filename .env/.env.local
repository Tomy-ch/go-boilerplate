# OS
OS_TZ=Asia/Tokyo

# Application
APP_MODE=development # development or production
APP_ENV=local
APP_SHUTDOWN_TIMEOUT=45s
# Server
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_SHUTDOWN_TIMEOUT=30s

# Metrics
METRICS_HOST=0.0.0.0
METRICS_PORT=6060

# Database
DB_DRIVER=pgx
DB_HOST=database
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres-password
DB_NAME=local
DB_SSL_MODE=disable

# Database Connection
DB_CONN_MAX_OPEN=10
DB_CONN_MAX_IDLE=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=10m

# Security
SECURITY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
SECURITY_CIDR="127.0.0.0/8"
