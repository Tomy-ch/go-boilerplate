      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(tree *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(env)",
      "Bash(date *)",
      "Bash(uname *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(comm *)",
      "Bash(diff *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(ps *)",
      "Bash(mkdir *)",
      "Bash(mkdir -p *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(python3 *)",
      "Bash(true)",

      "Bash(rm /tmp/*)",
      "Bash(rm -r /tmp/*)",
      "Bash(rm -f /tmp/*)",
      "Bash(rm -rf /tmp/*)",
      "Bash(rm -fr /tmp/*)",
      "Bash(rm /private/tmp/*)",
      "Bash(rm -r /private/tmp/*)",
      "Bash(rm -f /private/tmp/*)",
      "Bash(rm -rf /private/tmp/*)",
      "Bash(rm -fr /private/tmp/*)",
