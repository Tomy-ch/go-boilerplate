      "Bash(mv /private/tmp/*)",
      "Bash(cp /tmp/*)",
      "Bash(cp /private/tmp/*)",
      "Bash(touch /tmp/*)",
      "Bash(touch /private/tmp/*)",

      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git remote -v *)",
      "Bash(git remote get-url *)",
      "Bash(git remote show *)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(git ls-remote *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git config --get *)",
      "Bash(git config --list *)",
      "Bash(git stash list *)",
      "Bash(git stash show *)",
      "Bash(git tag -l *)",
      "Bash(git tag --list *)",
      "Bash(git describe *)",
      "Bash(git shortlog *)",
      "Bash(git reflog *)",
      "Bash(git fetch --dry-run *)",
      "Bash(git switch *)",

      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh repo view *)",
      "Bash(gh api *)",
      "Bash(gh auth status *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",

      "Bash(go version)",
      "Bash(go env *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go fmt *)",
      "Bash(go doc *)",
      "Bash(go list *)",
      "Bash(go mod graph *)",
      "Bash(go mod why *)",
      "Bash(go mod verify *)",
      "Bash(go mod download *)",
      "Bash(go tool *)",
      "Bash(gofmt *)",
      "Bash(goimports *)",

      "Bash(make)",
      "Bash(make *)",

      "Bash(graphify query *)",
      "Bash(graphify affected *)",
      "Bash(graphify god-nodes *)",
      "Bash(graphify path *)",
      "Bash(graphify explain *)",
      "Bash(graphify diagnose *)",
      "Bash(graphify update *)",
      "Bash(node .claude/scripts/graph-affected.ts *)",

      "Bash(lefthook run pre-commit)",

      "Bash(docker ps *)",
      "Bash(docker images *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose config *)",

      "Edit(.makefiles/**)",
      "Write(.makefiles/**)"
    ],
    "ask": [
      "Edit(makefile)",
      "Write(makefile)",
      "Edit(.makefiles/go/test.mk)",
      "Write(.makefiles/go/test.mk)",
      "Edit(.makefiles/go/golangci-lint.mk)",
      "Write(.makefiles/go/golangci-lint.mk)",
      "Edit(.makefiles/database/migrate.mk)",
      "Write(.makefiles/database/migrate.mk)",
      "Edit(.makefiles/github/lint.mk)",
      "Write(.makefiles/github/lint.mk)",
      "Edit(.makefiles/github/commitlint.mk)",
      "Write(.makefiles/github/commitlint.mk)",
      "Edit(.makefiles/github/pin.mk)",
      "Write(.makefiles/github/pin.mk)",

      "Edit(AGENTS.md)",
      "Write(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",

      "Bash(graphify * install*)",
      "Bash(graphify * uninstall*)",
      "Bash(graphify uninstall*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",

      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase *)",
      "Bash(git checkout *)",
      "Bash(git switch -f *)",
      "Bash(git switch -f)",
      "Bash(git switch -C *)",
      "Bash(git switch --force *)",
      "Bash(git switch --force)",
      "Bash(git switch --discard-changes *)",
      "Bash(git switch --discard-changes)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git stash pop *)",
      "Bash(git clean *)",
      "Bash(git tag -d *)",
      "Bash(git filter-branch *)",
      "Bash(git update-ref -d *)",
      "Bash(git commit --amend *)",
      "Bash(make apply-branch-protection*)",
      "Bash(make create-default-labels*)",
      "Bash(make delete-all-labels*)",
      "Bash(make tag-major*)",
      "Bash(make tag-minor*)",
      "Bash(make tag-patch*)",
      "Bash(make hotfix-patch*)",
      "Bash(make branch-major*)",
      "Bash(make branch-minor*)",
      "Bash(make branch-patch*)",
      "Bash(make setup-replace-module*)",
      "Bash(make setup-replace-app-metadata*)",
      "Bash(make setup-replace-license-copyright*)",
      "Bash(make setup-replace-repository-reference*)",
      "Bash(make setup-remove-sample-api*)",
      "Bash(make setup-repo*)",
      "Bash(make db-local-migrate-down*)",
      "Bash(make db-test-migrate-down*)",
      "Bash(make db-migrate-ci-down*)",
      "Bash(make db-migrate-down*)",
      "Bash(make fix-collation*)",
      "Bash(make go-update*)",
      "Bash(make gh-login*)",
      "Bash(make remove-generated-sqlc*)",

      "Edit(.makefiles/github/operation/**)",
      "Write(.makefiles/github/operation/**)",
      "Edit(.makefiles/github/setting/**)",
      "Write(.makefiles/github/setting/**)",
      "Edit(.makefiles/app/env.mk)",
      "Write(.makefiles/app/env.mk)",

      "Edit(**/*.gen.go)",
      "Write(**/*.gen.go)",
      "Edit(**/*.sql.go)",
      "Write(**/*.sql.go)",
      "Edit(**/openapi.gen.yaml)",
      "Write(**/openapi.gen.yaml)",
      "Edit(docs/openapi/**)",
      "Write(docs/openapi/**)",
      "Edit(docs/coverage/**)",
      "Write(docs/coverage/**)",
      "Edit(docs/db-schema/**)",
      "Write(docs/db-schema/**)",
      "Edit(docs/godoc/**)",
      "Write(docs/godoc/**)",
      "Edit(docs/portal/docs.json)",
      "Write(docs/portal/docs.json)",
      "Edit(docs/portal/guides/**)",
      "Write(docs/portal/guides/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/session-start-env.sh --hook"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/closed-loop/marks.sh --hook session-start"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/closed-loop/send.sh --hook"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/closed-loop/marks.sh --hook pre-compact"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/closed-loop/marks.sh --hook session-end"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.agents/doc-router/doc-router.sh --hook"
          }
        ]
      }
    ]
  }
}
