{
  "name": "docs-tools",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run one-to-one.gate.test.ts --no-cache && vitest run --coverage --no-cache --exclude one-to-one.gate.test.ts",
    "test:cached": "vitest run",
    "typecheck": "tsc --noEmit",
    "tsx": "cd .. && tsx",
    "lint:security": "eslint .",
    "lint:security:json": "eslint . --format json --output-file node_modules/.eslint-report.json",
    "lint:openapi-security": "cd .. && spectral lint openapi/openapi.yaml --ruleset .spectral.yaml",
    "check:openapi-client": "cd .. && tsx scripts/openapi-client-check"
  },
  "dependencies": {
    "@stoplight/spectral-cli": "6.17.0",
    "@stoplight/spectral-owasp-ruleset": "2.0.1",
    "commander": "15.0.0",
    "js-yaml": "4.3.2",
    "linkedom": "0.18.13",
    "mermaid": "12.2.0",
    "orval": "8.43.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@vitest/coverage-v8": "5.0.5",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-security": "4.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
