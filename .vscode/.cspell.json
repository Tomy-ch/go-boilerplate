{
  "version": "0.2",
  "language": "en",
  "useGitignore": true,
  "ignoreRegExpList": [
    "/`[\\s\\S]*?`/g"
  ],
  "ignorePaths": [
    "**/go.sum",
    "**/go.mod",
    ".github/settings/labels.json",
    "internal/**",
    "pkg/**",
    ".golangci.yaml",
    ".golangci-full.yaml"
  ],
  "words": [
    "codegen",
    "godotenv",
    "golangci",
    "IDOR",
    "lefthook",
    "makefiles",
    "mockgen",
    "oapi",
    "Redocly",
    "safecast",
    "sqlc",
    "xerror"
  ]
}
