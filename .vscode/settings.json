{
  "go.alternateTools": {
    "golangci-lint": "${HOME}/go/bin/golangci-lint",
    "gopls": "gopls",
    "gofumpt": "gofumpt",
    "gotests": "${HOME}/go/bin/gotests",
    "impl": "${HOME}/go/bin/impl"
  },

  // 保存時に golangci-lint 実行（Go拡張による）
  "go.lintTool": "golangci-lint-v2",

  // 保存時にファイル or パッケージ単位で実行
  "go.lintOnSave": "package",

  // gopls 設定(補完・定義ジャンプなど)
  "go.useLanguageServer": true,

  // Language Server(gopls) 設定
  "gopls": {
    "usePlaceholders": true,
    "formatting.gofumpt": true,
    "completeUnimported": true,
    "matcher": "Fuzzy",
    "staticcheck": true,
    "analyses": {
      "nilness": true,
      "unusedparams": true,
      "unusedvariable": true,
      "shadow": true
    }
  },

  // インデント・空白系（Go向け推奨）
  "[go]": {
    "editor.insertSpaces": false,
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
		"editor.guides.indentation": true,
    "editor.formatOnSave": true
  },
	"[markdown]": {
		"editor.tabSize": 2,
		"editor.formatOnSave": true,
		"editor.formatOnPaste": true
	},

  // 保存時にインポートと整形を自動実行
	"editor.codeActionsOnSave": {
		"source.fixAll.markdownlint": "always"
	},

  // material-icon-themeの設定の一部を追加する
  "material-icon-theme.folders.associations": {
    "dispatcher": "routes",
    "ctxhelper": "context",
    "errutil": "error",
    "xerror": "error",
    "testutil": "test"
  },

  // この設定を追加することで、特定のファイルやディレクトリをエクスプローラーから非表示にできます。
  "files.exclude": {
    "openapi/openapi.gen.yaml": true // 42crunch.vscode-openapi がエラーを誤検知するため、エクスプローラーから非表示にします。
  }
}
