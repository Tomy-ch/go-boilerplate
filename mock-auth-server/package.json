{
  "name": "mock-auth-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mock OIDC auth server (JWT Test Provider) for local development.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:integration": "node --test \"integration/**/*.test.ts\"",
    "lint:security": "eslint .",
    "lint:security:json": "eslint . --format json --output-file node_modules/.eslint-report.json",
    "lint:oapi": "redocly lint openapi/openapi.yaml",
    "gen:bundle": "redocly bundle openapi/openapi.yaml -o openapi/openapi.gen.yaml",
    "gen:zod": "orval --config orval.config.ts",
    "gen:jwks": "node scripts/gen-jwks-fixtures.ts",
    "gen:docs": "redocly build-docs openapi/openapi.yaml --output ../docs/openapi/mock-auth-server/index.html",
    "gen": "pnpm run gen:bundle && pnpm run gen:zod",
    "gen:check": "pnpm run gen && git diff --exit-code -- openapi/openapi.gen.yaml src/generated"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "hono": "^4.12.34",
    "jose": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-security": "^4.0.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
