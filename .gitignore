# -----ディレクトリ-----
# goライブラリの依存解決ディレクトリ
vendor/

# Node ライブラリの依存解決ディレクトリ（docker ビルド時/ローカルとも生成物）
node_modules/
# pnpm がコンテナ実行時にリポジトリ直下へ作る内容アドレス store。
.pnpm-store/

# ビルド済みのバイナリファイル
tmp/

# scripts 配下ツールのビルド出力（make build-scripts）。出力先をここへ固定することで、
# リポジトリ直下に go build の成果物が散らばるのを防ぐ
scripts/bin/

# graphify の出力（graph.json / GRAPH_REPORT.md 等）。コード変更ごとに動く派生物
graphify-out/

# Codex が issue ごとに作成する linked worktree。親 checkout から未追跡に見えるため、
# worktree 自身を含めて除外する。
.codex/worktrees/

# vitest のカバレッジ出力。各 vitest.config は reporter に html を含めていないが、
# --coverage.reporter=html を直に指定した実行が生む書き出しをコミット対象から外す。
# 裸の coverage/ は追跡・公開している docs/coverage/（Go 側）にも一致してしまうため、
# パッケージごとに列挙する。
docs-viewer/coverage/
scripts/coverage/

# ビルド済みのドキュメント。docs-viewer(Vite) の出力で、index.html は dist/ のハッシュ付き資産を
# 参照する対になっているため片方だけ追跡しない。deploy-docs.yaml が公開前に再ビルドする
docs/portal/dist/**
docs/portal/index.html

# -----ファイル-----
# ディレクトリの表示管理ファイル
.DS_Store

# DB スロットプールがworktree毎に書き出す占有情報（internal/cli/dbslot）
.gobp-db-slot

# scripts/ 配下の Go ツールを `go build` した実行ファイル。`-o` を省くとツール名のままリポジトリ
# 直下へ落ちるため `git add -A` に巻き込まれる。実行は全て `go run ./scripts/<name>` で行うので、
# 追跡してよい実行ファイルはここに 1 つも無い。一覧は `scripts/*/main.go` の親ディレクトリ名で、
# ツールを足したらここにも足す（総当たりで無視すると、拡張子を持たない makefile まで巻き込む）。
/actions-shellcheck
/base-branch
/cover-gate
/egress
/genctxkey
/go-cooldown
/load-band
/migration-lint
/pin-actions
/pin-images
/release
/repo-setup
/shell-lint
/sync-versions
/tool-cooldown
