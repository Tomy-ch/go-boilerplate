# -----ディレクトリ-----
# goライブラリの依存解決ディレクトリ
vendor/

# Node ライブラリの依存解決ディレクトリ（docker ビルド時/ローカルとも生成物）
node_modules/

# ビルド済みのバイナリファイル
tmp/

# scripts 配下ツールのビルド出力（make build-scripts）。出力先をここへ固定することで、
# リポジトリ直下に go build の成果物が散らばるのを防ぐ
scripts/bin/

# graphify の出力（graph.json / GRAPH_REPORT.md 等）。コード変更ごとに動く派生物
graphify-out/

# vitest のカバレッジ出力。各 vitest.config は reporter を text へ絞っているが、
# --coverage.reporter=html を直に指定した実行が生む書き出しをコミット対象から外す。
# 裸の coverage/ は追跡・公開している docs/coverage/（Go 側）にも一致してしまうため、
# パッケージごとに列挙する。
docs-viewer/coverage/
scripts/coverage/
mock-auth-server/coverage/

# lint:security:json（eslint.yaml が読む JSON レポート）の書き出し。手元で走らせても
# 同じ名前でワークスペース直下に落ちるため、カバレッジと同じくパッケージごとに列挙する。
docs-viewer/eslint-report.json
scripts/eslint-report.json
mock-auth-server/eslint-report.json

# ビルド済みのドキュメント。docs-viewer(Vite) の出力で、index.html は dist/ のハッシュ付き資産を
# 参照する対になっているため片方だけ追跡しない。deploy-docs.yaml が公開前に再ビルドする
docs/portal/dist/**
docs/portal/index.html

# -----ファイル-----
# ディレクトリの表示管理ファイル
.DS_Store

# DB スロットプールがworktree毎に書き出す占有情報（scripts/db-pool）
.gobp-db-slot
