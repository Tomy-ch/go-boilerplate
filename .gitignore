# -----ディレクトリ-----
# goライブラリの依存解決ディレクトリ
vendor/

# Node ライブラリの依存解決ディレクトリ（docker ビルド時/ローカルとも生成物）
node_modules/

# ビルド済みのバイナリファイル
tmp/

# graphify の出力（graph.json / GRAPH_REPORT.md 等）。コード変更ごとに動く派生物
graphify-out/

# -----ファイル-----
# ディレクトリの表示管理ファイル
.DS_Store

# DB スロットプールがworktree毎に書き出す占有情報（scripts/db-pool）
.gobp-db-slot
