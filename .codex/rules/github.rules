# 参照専用の GitHub CLI 操作は開発フローを中断せずに実行する。
prefix_rule(
    pattern = ["gh", "pr", ["checks", "diff", "list", "status", "view"]],
    decision = "allow",
    justification = "PR の参照操作は開発フロー中に自動実行する",
)
prefix_rule(
    pattern = ["gh", "issue", ["list", "status", "view"]],
    decision = "allow",
    justification = "Issue の参照操作は開発フロー中に自動実行する",
)
prefix_rule(
    pattern = ["gh", "run", ["list", "view", "watch"]],
    decision = "allow",
    justification = "Actions 実行結果の参照操作は開発フロー中に自動実行する",
)
prefix_rule(
    pattern = ["gh", "workflow", ["list", "view"]],
    decision = "allow",
    justification = "Workflow の参照操作は開発フロー中に自動実行する",
)
prefix_rule(
    pattern = ["gh", "repo", ["list", "view"]],
    decision = "allow",
    justification = "Repository の参照操作は開発フロー中に自動実行する",
)
prefix_rule(
    pattern = ["gh", "release", ["list", "view"]],
    decision = "allow",
    justification = "Release の参照操作は開発フロー中に自動実行する",
)

# エージェントが必要と判断しても、外部状態を変更する操作は対話確認する。
prefix_rule(
    pattern = ["gh", "pr", ["close", "comment", "create", "edit", "merge", "ready", "reopen", "review"]],
    decision = "prompt",
    justification = "PR を変更する操作は人の確認が必要",
)
prefix_rule(
    pattern = ["gh", "issue", ["close", "comment", "create", "edit", "lock", "reopen", "transfer", "unlock"]],
    decision = "prompt",
    justification = "Issue を変更する操作は人の確認が必要",
)
prefix_rule(
    pattern = ["gh", "run", ["cancel", "rerun"]],
    decision = "prompt",
    justification = "Actions 実行状態を変更する操作は人の確認が必要",
)
prefix_rule(
    pattern = ["gh", "workflow", ["disable", "enable", "run"]],
    decision = "prompt",
    justification = "Workflow を変更または起動する操作は人の確認が必要",
)
prefix_rule(
    pattern = ["gh", "release", ["create", "edit", "upload"]],
    decision = "prompt",
    justification = "Release を変更する操作は人の確認が必要",
)

# 破壊的な GitHub 操作は拒否し、意図的な管理手順に委ねる。
prefix_rule(
    pattern = ["gh", "repo", "delete"],
    decision = "forbidden",
    justification = "リポジトリ削除は Codex から実行しない",
)
prefix_rule(
    pattern = ["gh", "release", "delete"],
    decision = "forbidden",
    justification = "Release 削除は Codex から実行しない",
)
