# boilerplate-only:begin
# ローカル開発用 fixture の既知検出だけを許可する完全 fingerprint。
# 履歴スキャンの fingerprint はコミット SHA と docker/ 接頭辞を含む。
4eb9ea41915735f7d4354a09c28afe0422e404ab:docker-compose.yaml:generic-api-key:133
internal/integration/testdata/keys/mock-key-1.pem:private-key:1
internal/integration/testdata/keys/mock-key-2.pem:private-key:1
docker/garage/garage.toml:generic-api-key:12
daf3f6a9bfa7ced79fe84d0ebf18f42b73eee40b:docker/mock-auth-server/keys/mock-key-2.pem:private-key:1
daf3f6a9bfa7ced79fe84d0ebf18f42b73eee40b:docker/mock-auth-server/keys/mock-key-retired.pem:private-key:1
a77359f8d20ba3797acf260ecfc9c789e34f9e7d:docker/mock-auth-server/keys/mock-key-1.pem:private-key:1
# AUTH_JWKS_URL はコンテナ内部の URL で資格情報ではない。ホスト名の auth と
# ポート以降の文字列が generic-api-key の keyword+entropy 条件に当たる誤検知。
env/.env:generic-api-key:42
# 64 は履歴（gitleaks git）側、65 は現在のツリー側の OBJECT_STORAGE_SECRET_ACCESS_KEY。
# SHA 無しの fingerprint は履歴の検出にも当たるため、行がずれた側だけ足すと履歴が落ちる。
env/.env:generic-api-key:64
env/.env:generic-api-key:65
# boilerplate-only:end
