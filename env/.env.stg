# OS
OS_TZ=Asia/Tokyo

# Application
APP_MODE=production # development or production
APP_LOG_LEVEL=debug # debug/info/warn/error
APP_NAME=Boilerplate
APP_ENV=stg

# Server
SERVER_HOST=stg.api.example.com
SERVER_PORT=8080

# Metrics
METRICS_HOST=stg.metrics.example.com
METRICS_PORT=6060
# METRICS_USERNAME
# METRICS_PASSWORD

# Observability
OBS_TRACES_EXPORTER=
OBS_METRICS_EXPORTER=
OBS_LOGS_EXPORTER=
OBS_OTLP_ENDPOINT=
OBS_MASKED_DB_QUERY_ARGS=true
OBS_TARGET_STATUS_CODES=400,401,403,404,409,422,500,501,503

# Database
# DB_HOST
# DB_PORT
# DB_USER
# DB_PASSWORD
# DB_NAME
# DB_SSL_MODE
DB_PING_TIMEOUT=10s

# Security
SECURITY_ALLOWED_ORIGINS=https://stg.example.com
SECURITY_CIDR="127.0.0.0/8"
SECURITY_CONTENT_TYPE_NOSNIFF=nosniff
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_HSTS_MAX_AGE=8760h # 1 year
SECURITY_HSTS_EXCLUDE_SUBDOMAINS=false
SECURITY_HSTS_PRELOAD_ENABLED=false
SECURITY_REFERRER_POLICY=no-referrer

# Cookie
SECURE_COOKIE_SECURE=true
SECURE_COOKIE_SAME_SITE=Strict
SECURE_COOKIE_DOMAIN=stg.example.com
