# OS
OS_TZ=Asia/Tokyo

# Application
APP_MODE=development # development or production
APP_LOG_LEVEL=debug # debug/info/warn/error
APP_NAME=Boilerplate
APP_ENV=ci
APP_SHUTDOWN_TIMEOUT=45s

# Server
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=65s
SERVER_IDLE_TIMEOUT=60s
SERVER_REQUEST_TIMEOUT=60s

# Metrics
METRICS_HOST=0.0.0.0
METRICS_PORT=6060
METRICS_USERNAME=metrics-user
METRICS_PASSWORD=metrics-password

# Observability
OBS_TRACES_EXPORTER=
OBS_METRICS_EXPORTER=
OBS_LOGS_EXPORTER=
OBS_OTLP_ENDPOINT=
OBS_OTLP_PROTOCOL=http/protobuf
OBS_MASKED_DB_QUERY_ARGS=false
OBS_TARGET_STATUS_CODES=400,401,403,404,409,422,429,500,501,503

# Database
DB_DRIVER=pgx
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres-password
DB_NAME=test
DB_SSL_MODE=disable
DB_PING_TIMEOUT=5s
DB_SLOW_QUERY_WARN_THRESHOLD=500ms
DB_STATEMENT_TIMEOUT=30s
DB_LOCK_TIMEOUT=10s
DB_TX_MAX_RETRIES=3
DB_TX_RETRY_BASE_BACKOFF=5ms
DB_TX_RETRY_MAX_BACKOFF=100ms

# Database Connection
DBCONN_MAX_CONNS=10
DBCONN_MIN_CONNS=5
DBCONN_MAX_LIFETIME=30m
DBCONN_MAX_IDLE_TIME=10m

# Security
SECURITY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
SECURITY_CIDR="127.0.0.0/8"
SECURITY_CONTENT_TYPE_NOSNIFF=nosniff
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_HSTS_MAX_AGE=0
SECURITY_HSTS_EXCLUDE_SUBDOMAINS=false
SECURITY_HSTS_PRELOAD_ENABLED=false
SECURITY_REFERRER_POLICY=no-referrer
SECURITY_BCRYPT_COST=4

# Cookie
SECURE_COOKIE_SECURE=true
SECURE_COOKIE_SAME_SITE=Strict
SECURE_COOKIE_DOMAIN=localhost

# Auth
AUTH_COOKIE_NAME=auth_token
AUTH_HEADER_NAME=Authorization
AUTH_ALLOWED_HEADER_BEARER=true
