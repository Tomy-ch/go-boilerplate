# OS
OS_TZ=Asia/Tokyo

# Application
APP_MODE=development # development or production
APP_LOG_LEVEL=debug # debug/info/warn/error
APP_NAME=Boilerplate
APP_ENV=local

# Server
SERVER_HOST=localhost
SERVER_PORT=8080

# Metrics
METRICS_HOST=0.0.0.0
METRICS_PORT=6060
METRICS_USERNAME=metrics-user
METRICS_PASSWORD=metrics-password

# Observability
OBS_TRACES_EXPORTER=otlp
OBS_METRICS_EXPORTER=otlp
OBS_LOGS_EXPORTER=otlp
OBS_OTLP_ENDPOINT=http://observability:4318
OBS_MASKED_DB_QUERY_ARGS=false
OBS_TARGET_STATUS_CODES=400,401,403,404,405,409,422,429,500,501,503

# Database
DB_HOST=database
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres-password
DB_NAME=local
DB_SSL_MODE=disable
DB_PING_TIMEOUT=5s

# Auth (JWT / JWKS) — local dev は mock 認証サーバー（docker: mock_auth_server）を検証する。
# ISSUER は token の iss と一致させる（mock の OIDC_ISSUER=ホスト向け URL）。JWKS はコンテナ名で内部取得。
AUTH_ISSUER=http://localhost:4000
AUTH_AUDIENCE=go-boilerplate-api
AUTH_JWKS_URL=http://mock_auth_server:4000/.well-known/jwks.json

# Security
SECURITY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
SECURITY_CIDR="127.0.0.0/8"
SECURITY_CONTENT_TYPE_NOSNIFF=nosniff
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_HSTS_MAX_AGE=0
SECURITY_HSTS_EXCLUDE_SUBDOMAINS=false
SECURITY_HSTS_PRELOAD_ENABLED=false
SECURITY_REFERRER_POLICY=no-referrer

# Cookie
SECURE_COOKIE_SECURE=true
SECURE_COOKIE_SAME_SITE=Strict
SECURE_COOKIE_DOMAIN=localhost

# Object Storage (S3-compatible; local は docker service garage)
OBJECT_STORAGE_ENDPOINT=http://garage:3900
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=gobp-local
# Garage のアクセスキーは GK+24hex 形式・secret は 64hex（docker/garage/init.sh で import する固定値）。
OBJECT_STORAGE_ACCESS_KEY_ID=GK1234567890abcdef12345678
OBJECT_STORAGE_SECRET_ACCESS_KEY=1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
OBJECT_STORAGE_USE_PATH_STYLE=true
OBJECT_STORAGE_MAX_UPLOAD_BYTES=5242880

# sample-api:begin
# Outbox publish 先（local は docker service elasticmq。キュー名は docker/elasticmq/elasticmq.conf と対）
OUTBOX_PUBLISHER=sqs
OUTBOX_QUEUE_ENDPOINT=http://elasticmq:9324
OUTBOX_QUEUE_REGION=us-east-1
OUTBOX_QUEUE_URL=http://elasticmq:9324/000000000000/gobp-events
# ElasticMQ は署名を検証しないため、値は任意のダミーでよい（本番は IAM ロール等へ差し替える）。
OUTBOX_QUEUE_ACCESS_KEY_ID=local-dummy-access-key
OUTBOX_QUEUE_SECRET_ACCESS_KEY=local-dummy-secret-key
# sample-api:end
