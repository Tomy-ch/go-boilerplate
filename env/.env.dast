# OS
OS_TZ=Asia/Tokyo

# Application
APP_MODE=development # development or production
APP_LOG_LEVEL=debug # debug/info/warn/error
APP_NAME=Boilerplate
APP_ENV=dast

# Server
SERVER_HOST=localhost
SERVER_PORT=8080

# Metrics
METRICS_HOST=0.0.0.0
METRICS_PORT=6060
METRICS_USERNAME=metrics-user
METRICS_PASSWORD=metrics-password

# Observability
OBS_TRACES_EXPORTER=
OBS_METRICS_EXPORTER=
OBS_LOGS_EXPORTER=
OBS_OTLP_ENDPOINT=
OBS_MASKED_DB_QUERY_ARGS=false
OBS_TARGET_STATUS_CODES=400,401,403,404,405,409,422,429,500,501,503

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres-password
DB_NAME=test
DB_SSL_MODE=disable
# local から動かす理由は env/README.md の該当行を参照。
DB_PING_TIMEOUT=30s

# Database Connection Pool — 既定から外す理由は env/README.md の該当行を参照。
DBCONN_MIN_CONNS=0

# Auth (JWT / JWKS) — dast は ci と違い、mock 認証サーバーが発行する実 JWT を実際に検証する。
# ISSUER は token の iss と一致させる（スキャンを回す側が mock の OIDC_ISSUER をこの値から取る）。
# seed の user_identities が展開する issuer でもあるため、ずれると全リクエストが 401 になる。
# JWKS_URL は置かない。アプリと mock 認証サーバーが同じ localhost に居て split-horizon が無いため、
# issuer から OIDC discovery で jwks_uri を導出させ、その経路も実際に通す。
AUTH_ISSUER=http://localhost:4000
AUTH_AUDIENCE=go-boilerplate-api

# Security
SECURITY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
SECURITY_CIDR="127.0.0.0/8"
SECURITY_CONTENT_TYPE_NOSNIFF=nosniff
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_HSTS_MAX_AGE=0
SECURITY_HSTS_EXCLUDE_SUBDOMAINS=false
SECURITY_HSTS_PRELOAD_ENABLED=false
SECURITY_REFERRER_POLICY=no-referrer

# Cookie
SECURE_COOKIE_SECURE=true
SECURE_COOKIE_SAME_SITE=Strict
SECURE_COOKIE_DOMAIN=localhost

# Object Storage (S3-compatible; スキャンは object storage へ到達しないため endpoint は空)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=gobp-dast
OBJECT_STORAGE_ACCESS_KEY_ID=dast-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=dast-secret-key
OBJECT_STORAGE_USE_PATH_STYLE=true
OBJECT_STORAGE_MAX_UPLOAD_BYTES=5242880

# worker が consume するキュー（dast は実ブローカーを起動しないため、疎通しないダミー値。
# worker の DI グラフを起動するテストが未設定で fail-closed になるのを避けるために置く）
CONSUMER_QUEUE_ENDPOINT=http://localhost:9324
CONSUMER_QUEUE_REGION=us-east-1
CONSUMER_QUEUE_URL=http://localhost:9324/000000000000/gobp-events
CONSUMER_QUEUE_DLQ_URL=http://localhost:9324/000000000000/gobp-events-dlq
CONSUMER_QUEUE_ACCESS_KEY_ID=dast-access-key
CONSUMER_QUEUE_SECRET_ACCESS_KEY=dast-secret-key
