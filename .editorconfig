root = true
[*]
insert_final_newline = true
indent_style = tab
indent_size = 4
end_of_line = lf
charset = utf-8

[*.go]
indent_style = tab
indent_size = 4

[*.json]
indent_style = space
indent_size = 2

[*.md]
indent_size = 2
indent_style = space
trim_trailing_whitespace = false

[*.mk]
indent_style = tab
indent_size = 2

[*.sql]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 2

[*.yml]
indent_style = space
indent_size = 2

[*.yaml]
indent_style = space
indent_size = 2

[Dockerfile]
indent_style = space
indent_size = 2

[makefile]
indent_style = tab
indent_size = 2
