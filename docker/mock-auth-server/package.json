{
  "name": "mock-auth-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mock OIDC auth server (JWT Test Provider) for local development.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "lint:oapi": "redocly lint openapi/openapi.yaml",
    "gen:bundle": "redocly bundle openapi/openapi.yaml -o openapi/openapi.gen.yaml",
    "gen:zod": "orval --config orval.config.ts",
    "gen:docs": "redocly build-docs openapi/openapi.yaml --output ../../docs/openapi/mock-auth-server/index.html",
    "gen": "npm run gen:bundle && npm run gen:zod",
    "gen:check": "npm run gen && git diff --exit-code -- openapi/openapi.gen.yaml src/generated"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "hono": "^4.12.31",
    "jose": "^5.9.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
